#!/usr/bin/env bash
set -euo pipefail

# uv tool ставит бинари в ~/.local/bin; GUI-клиенты его не наследуют
export PATH="$HOME/.local/bin:$PATH"

command -v just >/dev/null 2>&1 || {
    echo "pre-commit: just не найден — uv tool install rust-just" >&2
    exit 1
}

just guard-claude-md || exit 1
just deps-check
just lint
