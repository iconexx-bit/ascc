      "desc": "Ensure S3 buckets have Public Access Block enabled and do not grant public read access.",
      "product_uid": "prowler",
      "title": "S3 Bucket datalake-raw allows public read access",
      "types": ["Sensitive Data Exposure"],
      "uid": "prowler-aws-s3_bucket_level_public_access_block-123456789012-us-east-1-datalake-raw"
    },
    "resources": [
      {
        "uid": "arn:aws:s3:::datalake-raw",
        "name": "datalake-raw",
        "type": "AwsS3Bucket",
        "region": "us-east-1",
        "tags": [
          { "key": "DataClassification", "value": "PII" },
          { "key": "Environment", "value": "production" }
        ],
        "data": { "public_access_block": false, "acl": "public-read" }
      }
    ],
    "compliance": { "status": "FAIL" },
    "risk_details": "Bucket is reachable from the public internet and contains objects tagged as PII, exposing customer data to unauthenticated access.",
    "remediation": {
      "desc": "Enable S3 Block Public Access at the bucket and account level, and remove the public-read ACL.",
      "references": ["https://docs.aws.amazon.com/AmazonS3/latest/userguide/access-control-block-public-access.html"]
    },
